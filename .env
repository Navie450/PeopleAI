# PeopleAI Microservices Environment Variables
# Copy this file to .env and fill in the values

# General
NODE_ENV=development

# Database (shared PostgreSQL instance)
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# JWT (shared between auth-service and employee-service)
JWT_SECRET=peopleai-jwt-secret-key-dev-only-change-in-production-2024
JWT_REFRESH_SECRET=peopleai-refresh-secret-key-dev-only-change-in-prod-2024
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=simple
