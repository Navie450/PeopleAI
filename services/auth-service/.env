NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peopleai_auth
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_LOGGING=false
JWT_SECRET=peopleai-jwt-secret-key-dev-only-change-in-production-2024
JWT_REFRESH_SECRET=peopleai-refresh-secret-key-dev-only-change-in-prod-2024
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
LOG_FORMAT=simple
